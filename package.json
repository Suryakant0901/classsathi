{
  "name": "class-sathi",
  "version": "1.0.0",
  "description": "ClassSathi — Class 9 & 10 Attendance Management System (MERN Stack)",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "postinstall": "npm install --prefix client",
    "server": "cd server && node server.js",
    "client": "cd client && npm run dev",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "keywords": [
    "attendance",
    "school-management",
    "class9",
    "class10",
    "mern",
    "register"
  ],
  "author": "ClassSathi",
  "license": "ISC"
}
